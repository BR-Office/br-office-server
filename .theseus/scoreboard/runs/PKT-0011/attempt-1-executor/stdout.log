mString('DOCX')).toBe(C.AVS_OFFICESTUDIO_FILE_DOCUMENT_DOCX);\n    expect(formatChecker.getFormatFromString('XlSx')).toBe(C.AVS_OFFICESTUDIO_FILE_SPREADSHEET_XLSX);\n  });\n\n  test('getFormatFromString returns UNKNOWN for unknown, empty and missing input', () => {\n    expect(formatChecker.getFormatFromString('nope')).toBe(UNKNOWN);\n    expect(formatChecker.getFormatFromString('')).toBe(UNKNOWN);\n    expect(formatChecker.getFormatFromString(undefined)).toBe(UNKNOWN);\n    expect(formatChecker.getFormatFromString(null)).toBe(UNKNOWN);\n  });\n\n  test('getFormatFromString does not trim or strip a leading dot', () => {\n    expect(formatChecker.getFormatFromString('.docx')).toBe(UNKNOWN);\n    expect(formatChecker.getFormatFromString(' docx')).toBe(UNKNOWN);\n  });\n\n  test('getFormatFromString throws on a non-string truthy value', () => {\n    expect(() => formatChecker.getFormatFromString(123)).toThrow(TypeError);\n  });\n\n  test('getStringFromFormat returns empty string for unknown ids', () => {\n    expect(formatChecker.getStringFromFormat(UNKNOWN)).toBe('');\n    expect(formatChecker.getStringFromFormat(-1)).toBe('');\n    expect(formatChecker.getStringFromFormat(undefined)).toBe('');\n  });\n\n  test('getStringFromFormat for non-reversible ids', () => {\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_DOCUMENT_DOC_FLAT)).toBe('doc');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_DOCUMENT_DOCX_FLAT)).toBe('docx');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_DOCUMENT_DOCX_PACKAGE)).toBe('xml');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_DOCUMENT_OFORM_PDF)).toBe('pdf');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_SPREADSHEET_XLSX_FLAT)).toBe('xlsx');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_OTHER_HTMLZIP)).toBe('zip');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_OTHER_JSON)).toBe('json');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_IMAGE)).toBe('zip');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_CANVAS_WORD)).toBe('bin');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_CANVAS_SPREADSHEET)).toBe('bin');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_CANVAS_PRESENTATION)).toBe('bin');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_CANVAS_PDF)).toBe('bin');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_CANVAS_DRAW)).toBe('bin');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_OTHER_OLD_DOCUMENT)).toBe('doct');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_OTHER_OLD_PRESENTATION)).toBe('pptt');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_OTHER_OLD_DRAWING)).toBe('pptt');\n    expect(formatChecker.getStringFromFormat(C.AVS_OFFICESTUDIO_FILE_TEAMLAB_VSDY)).toBe('vsdt');\n  });\n\n  test('vsdt has no reverse mapping', () => {\n    expect(formatChecker.getFormatFromString('vsdt')).toBe(UNKNOWN);\n  });\n});\n\ndescribe('formatchecker format classification', () => {\n  const D = C.AVS_OFFICESTUDIO_FILE_DOCUMENT_DOCX;\n  const S = C.AVS_OFFICESTUDIO_FILE_SPREADSHEET_XLSX;\n  const P = C.AVS_OFFICESTUDIO_FILE_PRESENTATION_PPTX;\n\n  // [label, format, isDoc, isSheet, isPres, isOOX, isBrowserEditor]\n  const table = [\n    ['docx', D, true, false, false, true, false],\n    ['doc', C.AVS_OFFICESTUDIO_FILE_DOCUMENT_DOC, true, false, false, false, false],\n    ['odt', C.AVS_OFFICESTUDIO_FILE_DOCUMENT_ODT, true, false, false, false, false],\n    ['docm', C.AVS_OFFICESTUDIO_FILE_DOCUMENT_DOCM, true, false, false, true, false],\n    ['dotx', C.AVS_OFFICESTUDIO_FILE_DOCUMENT_DOTX, true, false, false, true, false],\n    ['oform', C.AVS_OFFICESTUDIO_FILE_DOCUMENT_OFORM, true, false, false, true, false],\n    ['docxf', C.AVS_OFFICESTUDIO_FILE_DOCUMENT_DO