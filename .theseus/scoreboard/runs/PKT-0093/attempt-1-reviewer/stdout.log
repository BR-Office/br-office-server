e repository. This follows from the target, which only allows `baseline.md`.\n\n**Rejection triggers (TEP-0004)**\n- The executor log is filled in.\n- No follow-ups were requested, so an empty Spawned packets section is fine.\n- The two surprises in the log (the stray git link and one Playwright timeout that passed on rerun) are environment events, not code behavior, so no test needs to keep them.\n- The friction line is present.\n\nVERDICT: APPROVE baseline section recorded within contract; 143/143 incremental, font collection 271→0.5 ms, goal met","ttft_ms":4542,"type":"result","duration_ms":21334,"uuid":"781fea41-1ebe-4713-91c7-0007140bc347","ttft_stream_ms":2872,"time_to_request_ms":353,"time_to_request_phases_ms":{"other":13,"system_prompt":70,"resume_other":1,"process_user_input":8,"input_attachments":53,"input_hooks":8,"conversation_append":1,"transcript_persist":24,"tool_pool_refresh":0,"init_message":14,"init_frame_send":7,"engine_pickup":1,"loop_entry":8,"message_prep":1,"model_config_wait":5,"autocompact":2,"request_announcements":33,"query_setup":13,"auto_mode_context_wait":24,"model_gates":0,"tool_schema_build":50,"message_normalization":4,"client_creation":4,"request_build":9},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":140,"time_to_request_cpu_ms":188,"time_to_request_major_faults":68,"process_rss_mib_turn_start":198,"process_anon_mib_turn_start":129,"process_rss_mib_result":205,"process_anon_mib_result":123,"process_peak_rss_mib":213,"process_cpu_ms_turn":866,"process_wall_ms_turn":21334,"process_cpu_ms_streaming":304,"process_wall_ms_streaming":13314,"main_stream_count":4,"main_stream_event_count":258,"main_stream_chunk_count":69,"process_turn_states":{"main_stream":{"cpu_ms":304,"wall_ms":13314,"entries":4},"tool":{"cpu_ms":51,"wall_ms":201,"entries":2},"first_event_wait":{"cpu_ms":230,"wall_ms":7286,"entries":4},"before_first_request":{"cpu_ms":189,"wall_ms":353,"entries":1},"between_requests":{"cpu_ms":80,