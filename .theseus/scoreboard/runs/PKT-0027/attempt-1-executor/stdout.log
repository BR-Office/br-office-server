ls, see the GNU AGPL at: http://www.gnu.org/licenses/agpl-3.0.html\n *\n * The  interactive user interfaces in modified source and object code versions\n * of the Program must display Appropriate Legal Notices, as required under\n * Section 5 of the GNU AGPL version 3.\n *\n * All the Product's GUI elements, including illustrations and icon sets, as\n * well as technical writing content are licensed under the terms of the\n * Creative Commons Attribution-ShareAlike 4.0 International. See the License\n * terms at http://creativecommons.org/licenses/by-sa/4.0/legalcode\n *\n */\n\n// Characterization of convertJson/convertXml (PKT-0027): sync and async flow,\n// polling loop, CONVERT_TIMEOUT and error statuses, with taskresult and the queue mocked.\n\nconst {describe, test, expect, jest, beforeEach, afterEach} = require('@jest/globals');\n\njest.mock('./../../DocService/sources/taskresult', () => {\n  const actual = jest.requireActual('./../../DocService/sources/taskresult');\n  return {...actual, upsert: jest.fn(), select: jest.fn()};\n});\njest.mock('./../../DocService/sources/DocsCoServer', () => ({\n  getRequestParams: jest.fn(),\n  addTask: jest.fn()\n}));\njest.mock('./../../DocService/sources/canvasservice', () => ({\n  cleanupErrToReload: jest.fn(),\n  commandSfctByCmd: jest.fn()\n}));\njest.mock('./../../DocService/sources/wopiClient', () => ({}));\njest.mock('./../../Common/sources/storage/storage-base', () => ({\n  listObjects: jest.fn(),\n  getSignedUrl: jest.fn()\n}));\n\nconst taskResult = require('./../../DocService/sources/taskresult');\nconst docsCoServer = require('./../../DocService/sources/DocsCoServer');\nconst canvasService = require('./../../DocService/sources/canvasservice');\nconst storage = require('./../../Common/sources/storage/storage-base');\nconst utils = require('./../../Common/sources/utils');\nconst constants = require('./../../Common/sources/constants');\nconst commonDefines = require('./../../Common/sources/commondefines');\nconst operationContext = require('./../../Common/sources/operationContext');\nconst converterService = require('./../../DocService/sources/converterservice');\n\nconst FileStatus = commonDefines.FileStatus;\nconst TIMEOUT_MS = 3000;\n\nlet responses;\nlet addedTasks;\n\nfunction row(status, extra) {\n  return {status, status_info: 0, last_open_date: new Date(), password: null, ...extra};\n}\n\nfunction mockParams(params, code = constants.NO_ERROR) {\n  docsCoServer.getRequestParams.mockResolvedValue({code, params});\n}\n\nfunction makeReq(query = {}) {\n  return {query, headers: {}, body: {}};\n}\n\nasync function run(params, {query, isJson = true} = {}) {\n  mockParams(params);\n  const fn = isJson ? converterService.convertJson : converterService.convertXml;\n  await fn(makeReq(query), {});\n  return responses[responses.length - 1];\n}\n\nconst baseParams = {key: 'abc', url: 'http://example.com/a.docx', filetype: 'docx', outputtype: 'pdf'};\n\nbeforeEach(() => {\n  responses = [];\n  addedTasks = [];\n  jest.spyOn(operationContext.Context.prototype, 'initFromRequest').mockImplementation(() => {});\n  jest.spyOn(operationContext.Context.prototype, 'initTenantCache').mockResolvedValue(undefined);\n  jest.spyOn(utils, 'fillResponse').mockImplementation((req, res, status, isJson) => {\n    responses.push({status, isJson});\n  });\n  jest.spyOn(utils, 'sleep').mockResolvedValue(undefined);\n  jest.spyOn(utils, 'getConvertionTimeout').mockReturnValue(TIMEOUT_MS);\n  jest.spyOn(utils, 'getBaseUrlByRequest').mockReturnValue('http://base');\n  taskResult.upsert.mockResolvedValue({isInsert: true});\n  taskResult.select.mockResolvedValue([row(FileStatus.Ok)]);\n  docsCoServer.addTask.mockImplementation(function* (queueData, priority) {\n    addedTasks.push({queueData, priority});\n  });\n  canvasService.cleanupErrToReload.mockResolvedValue(undefined);\n  storage.getSignedUrl.mockImplementation(async (ctx, baseUrl, p) => `${baseUrl}/${p}`);\n  delete process.env.DEFAULT_SHARD_KEY;\n});\n\nafterEach(() => {\n  jest.restoreAllMocks();\n  jest.clearAllMocks();\n  delete process.env.DEFAULT_SHARD_KEY;\n});\n\ndescribe('convertJson async mode', () => {\n  test('async=true answers at once without polling', async () => {\n    const r = await run({...baseParams, async: true});\n    expect(r.isJson).toBe(true);\n    expect(r.status.end).toBe(false);\n    expect(r.status.err).toBe(constants.NO_ERROR);\n    expect(addedTasks).toHaveLength(1);\n    expect(addedTasks[0].priority).toBe(constants.QUEUE_PRIORITY_LOW);\n    expect(taskResult.select).not.toHaveBeenCalled();\n    expect(utils.sleep).not.toHaveBeenCalled();\n  });\n\n  test('async as string \"true\" is async', async () => {\n    const r = await run({...baseParams, async: 'true'});\n    expect(r.status.end).toBe(false);\n    expect(utils.sleep).not.toHaveBeenCalled();\n  });\n\n  test('DEFAULT_SHARD_KEY without shard query forces sync', async () => {\n    process.env.DEFAULT_SHARD_KEY = 'shard';\n    const r = await run({...baseParams, async: true});\n    expect(utils.sleep).toHaveBeenCalledTimes(1);\n    expect(r.status.end).toBe(true);\n  });\n\n  test('existing task already Ok is not re-queued and returns url', async () => {\n    taskResult.upsert.mockResolvedValue({isInsert: false});\n    const r = await run({...baseParams, async: true});\n    expect(addedTasks).toHaveLength(0);\n    expect(r.status.end).toBe(true);\n    expect(r.status.url).toBe('http://base/conv_abc_513/output.pdf');\n  });\n\n  test('existing task with status None is re-queued', async () => {\n    taskResult.upsert.mockResolvedValue({isInsert: false});\n    taskResult.select.mockResolvedValue([row(FileStatus.None)]);\n    const r = await run({...baseParams, async: true});\n    expect(addedTasks).toHaveLength(1);\n    expect(r.status.end).toBe(false);\n    expect(r.status.err).toBe(constants.NO_ERROR);\n  });\n});\n\ndescribe('convertJson sync mode (polling loop)', () => {\n  test('polls every CONVERT_ASYNC_DELAY ms until Ok and returns signed url', async () => {\n    taskResult.select\n      .mockResolvedValueOnce([row(FileStatus.WaitQueue)])\n      .mockResolvedValueOnce([row(FileStatus.WaitQueue)])\n      .mockResolvedValueOnce([row(FileStatus.Ok)]);\n    const r = await run({...baseParams, async: false});\n    expect(utils.sleep).toHaveBeenCalledTimes(3);\n    expect(utils.sleep).toHaveBeenCalledWith(1000);\n    expect(r.status.end).toBe(true);\n    expect(r.status.err).toBe(constants.NO_ERROR);\n    expect(r.status.url).toBe('http://base/conv_abc_513/output.pdf');\n  });\n\n  test('CONVERT_TIMEOUT once waitTime exceeds the timeout (strict >)', async () => {\n    taskResult.select.mockResolvedValue([row(FileStatus.WaitQueue)]);\n    const r = await run({...baseParams});\n    // 3000 ms timeout, 1000 ms per poll: 3 polls reach 3000 (not >), the 4th exceeds it.\n    expect(utils.sleep).toHaveBeenCalledTimes(4);\n    expect(r.status.err).toBe(constants.CONVERT_TIMEOUT);\n    expect(r.status.end).toBe(false);\n  });\n\n  test('Err returns status_info', async () => {\n    taskResult.select.mockResolvedValue([row(FileStatus.Err, {status_info: constants.CONVERT_DOWNLOAD})]);\n    const r = await run({...baseParams});\n    expect(r.status.err).toBe(constants.CONVERT_DOWNLOAD);\n    expect(canvasService.cleanupErrToReload).not.toHaveBeenCalled();\n  });\n\n  test('ErrToReload returns status_info and cleans up', async () => {\n    taskResult.select.mockResolvedValue([row(FileStatus.ErrToReload, {status_info: constants.CONVERT})]);\n    const r = await run({...baseParams});\n    expect(r.status.err).toBe(constants.CONVERT);\n    expect(canvasService.cleanupErrToReload).toHaveBeenCalledTimes(1);\n  });\n\n  test('NeedParams maps to UNKNOWN', async () => {\n    taskResult.select.mockResolvedValue([row(FileStatus.NeedParams)]);\n    const r = await run({...baseParams});\n    expect(r.status.err).toBe(constants.UNKNOWN);\n  });\n\n  test('missing task row maps to UNKNOWN', async () => {\n    taskResult.select.mockResolvedValue([]);\n    const r = await run({...baseParams});\n    expect(r.status.err).toBe(constants.UNKNOWN);\n  });\n\n  test('stale last_open_date gives CONVERT_TIMEOUT even when Ok', async () => {\n    taskResult.select.mockResolvedValue([row(FileStatus.Ok, {last_open_date: new Date(Date.now() - TIMEOUT_MS - 1000)})]);\n    const r = await run({...baseParams});\n    expect(r.status.err).toBe(constants.CONVERT_TIMEOUT);\n  });\n});\n\ndescribe('convertRequest error paths', () => {\n  test('unknown outputtype gives CONVERT_PARAMS without queueing', async () => {\n    const r = await run({...baseParams, outputtype: 'nope'});\n    expect(r.status.err).toBe(constants.CONVERT_PARAMS);\n    expect(addedTasks).toHaveLength(0);\n  });\n\n  test('auth failure code is passed through', async () => {\n    docsCoServer.getRequestParams.mockResolvedValue({code: constants.VKEY});\n    await converterService.convertJson(makeReq(), {});\n    expect(responses[0].status.err).toBe(constants.VKEY);\n  });\n\n  test('exception gives UNKNOWN', async () => {\n    taskResult.upsert.mockRejectedValue(new Error('db down'));\n    const r = await run({...baseParams});\n    expect(r.status.err).toBe(constants.UNKNOWN);\n  });\n\n  test('convertXml answers with isJson=false', async () => {\n    const r = await run({...baseParams}, {isJson: false});\n    expect(r.isJson).toBe(false);\n    expect(r.status.end).toBe(true);\n  });\n});\nEOF\ngrep -n \"^  CONVERT_DOWNLOAD\\|exports.CONVERT \\|exports.CONVERT_DOWNLOAD\\|exports.VKEY \\|QUEUE_PRIORITY_LOW\\b\" Common/sources/constants.js | head; .theseus/oracle/unit.sh converterService 2>&1 | tail -40"}},{"tool_name":"Bash","tool_use_id":"toolu_01YcBoWDePZ8wJnUXpWDCDtT","tool_input":{"command":"npm run lint:check > ../lint27.log 2>&1; echo exit=$?; tail -15 ../lint27.log"}},{"tool_name":"Bash","tool_use_id":"toolu_01SHm2TELNkKAdfmmPMwaS99","tool_input":{"command":"cd .theseus/spawn && f=PKT-0027-make-npm-run-lint-check-pass-ignore-or-fix-these.md && sed -i 's#    - \"\\[FILE\\]\"#    - eslint.config.js#; s#    - \"\\[WHAT MUST NOT CHANGE\\]\"#    - \"Lint rules for product code (DocService, Common, FileConverter, tests) are unchanged\"#; s#    - \"\\[ORACLE COMMAND\\]\"#    - npm run lint:check\\n    - .theseus/oracle/unit.sh#; s#  cards: \\[tooling\\]#  cards: []#' $f && sed -n 14,32p $f"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":27,"subtype":"success","api_error_status":null,"result":"PKT-0027 is only partly done: the new tests pass, but `npm run lint:check` still fails. My file has no lint errors. The 55 errors are all in measurement scripts that were already in the repository, outside my target.\n\n**What I did**\n- **Test file:** I wrote `tests/unit/converterService.tests.js` again from scratch. The version from attempts 1–3 was never committed, so it wasn't in this worktree. It has 16 tests on `convertJson`/`convertXml`, with the task database and the queue mocked. They pin down:\n  - async mode answers at once; `\"true\"` as a string counts as async; `DEFAULT_SHARD_KEY` without a shard query forces sync.\n  - sync mode checks the task status every 1000 ms and returns the signed URL when the task is done.\n  - `CONVERT_TIMEOUT` comes on the 4th check when the timeout is 3000 ms (the comparison is strict `>`).\n  - a task that is finished but has a stale `last_open_date` also gets `CONVERT_TIMEOUT`.\n  - error statuses: Err, ErrToReload (which also runs the cleanup), NeedParams → UNKNOWN, missing task → UNKNOWN.\n  - finished tasks are not queued again; tasks with status None are.\n  - an unknown output type, an auth failure code, an exception, and the XML variant.\n- **Acceptance results:**\n  - `.theseus/oracle/unit.sh` passes (149 passed, 1 skipped).\n  - `npm run lint:check` fails. The `external/` folder that ran it out of memory before is gone, so lint now completes. The 55 errors are all in `.theseus/oracle/perf/*.js`, the browser scripts added by the earlier perf packets.\n- **Follow-up:** I filed `.theseus/spawn/PKT-0027-make-npm-run-lint-check-pass-ignore-or-fix-these.md`. It targets `eslint.config.js` and suggests ignoring `.theseus/**`. Until it is merged, every packet whose acceptance includes `npm run lint:check` will fail the same way.\n- **Records:** I filled in the Executor log and the Lessons section, appended the friction line (`theseus validate` reports 0 errors), and made two commits.\n- **Permissions:** two shell commands were refused: one using a shell variable, one long heredoc. I wrote and edited those files with the file tools instead; nothing was skipped.\n\n**Decisions**\n- `utils` is stubbed with `jest.spyOn` rather than a `jest.mock` factory, because it and `operationContext` require each other.\n- The `addTask` mock returns an empty iterator. The code calls it with `yield*`, so it has to be iterable, and a generator with no `yield` breaks the `require-yield` lint rule.\n\n**Lessons for the Atlas**\n- A sync conversion always answers in whole seconds: it checks every 1000 ms and stops at the first check where the wait is strictly over the timeout.\n- `npm run lint:check` lints the whole repository, so broken method scripts block packets whose own files are clean.\n- Work from attempts before a release is lost unless it was committed.","ttft_ms":1820,"type":"result","duration_ms":149552,"uuid":"a96afca6-6b2b-4077-8e5a-86922f03d001","ttft_stream_ms":898,"time_to_request_ms":321,"time_to_request_phases_ms":{"other":9,"system_prompt":159,"resume_other":0,"process_user_input":4,"input_attachments":20,"input_hooks":3,"conversation